---
/** Page embarquable (iframe) : calculateur sans navigation, en français. noindex, hors sitemap. */
import '../../styles/global.css';
import AllBenefits from '../../components/calc/AllBenefits';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculateur des prestations canadiennes 2026 – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/fr/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <AllBenefits client:load lang="fr" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/fr/`} target="_blank" rel="noopener" class="underline">BenefitLedger</a> · calculé dans votre navigateur</p>
  </body>
</html>
