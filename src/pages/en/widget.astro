---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/benefits-calculator/" title="Canadian benefits calculator 2026" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the 2026 Canadian Benefits Calculator, Free of Charge" description="Embed the 2026 Canadian household benefits calculator in an iframe for free: one code to copy, no sign-up, no cookie, amounts updated in July and each OAS quarter." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the household benefits calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up, no fee. Settlement agencies, food banks, seniors’ centres and community newsrooms install it in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the credit link under the calculator stays visible, the calculator is not altered, and it comes with no warranty. Amounts are updated here each July, January and OAS quarter, so your page stays current without any work. French version: <code>{`${SITE_URL}/embed/calculateur-prestations/`}</code>.</p>
    <p>No visitor data reaches us: the calculation runs in their browser and the iframe writes no cookie. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/benefits-calculator/" title="Canadian benefits calculator 2026" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
